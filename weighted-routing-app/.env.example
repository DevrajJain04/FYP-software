# ============================================
# Green Corridor Frontend Configuration
# ============================================

# OpenRouteService API Key (for ORS fallback routing)
# Get your free API key at: https://openrouteservice.org/dev/#/signup
REACT_APP_ORS_API_KEY=eyJvcmciOiI1YjNjZTM1OTc4NTExMTAwMDFjZjYyNDgiLCJpZCI6ImY0MjA2NGM2NmFkZjRhYjc5NDA2ZDg2ODU2ZTM4NjI2IiwiaCI6Im11cm11cjY0In0=

# ============================================
# Backend API URLs (Green Corridor Microservices)
# ============================================
# These are the default local development URLs.
# Update these when deploying to production.

REACT_APP_ROUTING_API_URL=http://localhost:8000
REACT_APP_INGESTION_API_URL=http://localhost:8080
REACT_APP_AQI_SCRAPER_URL=http://localhost:8082

# ============================================
# Routing Mode Configuration
# ============================================
# 'backend' - Use Green Corridor backend (AQI-aware routing)
# 'ors' - Use OpenRouteService only (no AQI integration)
REACT_APP_ROUTING_MODE=backend

# ============================================
# AQI Data Provider
# ============================================
# 'backend' - Use Green Corridor backend (vehicle telemetry + scraped data)
# 'sample' - Use simulated/sample data (for development)
# 'openweather' - Use OpenWeather Air Pollution API
# 'waqi' - Use World Air Quality Index API
REACT_APP_AQI_PROVIDER=backend

# ============================================
# External AQI API Keys (Optional)
# ============================================
# Only needed if using external AQI providers instead of backend

# OpenWeather API Key
# Get your key at: https://openweathermap.org/api
REACT_APP_OPENWEATHER_API_KEY=940d4759a2bf06bd91e0f8f668fc21b8

# WAQI (World Air Quality Index) API Key
# Get your token at: https://aqicn.org/data-platform/token/
REACT_APP_WAQI_API_KEY=38034cc04484495c11dfb40a1e7bf6810d2b6cf2
